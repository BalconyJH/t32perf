{  "$defs": {    "SamplingCleanupRecovery": {      "const": true,      "type": "boolean"    },    "SamplingConfigureMethod": {      "description": "Requested sampling method for a configure event.",      "oneOf": [        {          "const": "realtime",          "description": "Runtime PC snooping without stopping the target.",          "type": "string"        },        {          "const": "stop_and_go",          "description": "Periodic stop-and-restart PC sampling.",          "type": "string"        }      ]    },    "SamplingDriverOwner": {      "description": "Fixed sidecar identity allowed to emit sampling-driver events.",      "oneOf": [        {          "const": "lauterbach-sampling-mcp/v1",          "description": "Current Lauterbach sampling MCP sidecar contract.",          "type": "string"        }      ]    }  },  "$id": "t32perf.sampling-driver-event/v1",  "$schema": "https://json-schema.org/draft/2020-12/schema",  "description": "One append-only event emitted by the sampling sidecar.",  "oneOf": [    {      "description": "Intent to configure TRACE32 PERF.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "method": {              "$ref": "#/$defs/SamplingConfigureMethod",              "description": "Sampling method to configure."            }          },          "required": [            "method"          ],          "type": "object"        },        "event": {          "const": "configure_intent",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "TRACE32 PERF configuration was observed.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "method": {              "$ref": "#/$defs/SamplingConfigureMethod",              "description": "Sampling method TRACE32 reported after configuration."            }          },          "required": [            "method"          ],          "type": "object"        },        "event": {          "const": "configure_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Intent to start a bounded sampling interval.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "duration_ms": {              "description": "Requested capture duration in milliseconds.",              "format": "uint32",              "maximum": 60000,              "minimum": 1,              "type": "integer"            }          },          "required": [            "duration_ms"          ],          "type": "object"        },        "event": {          "const": "start_intent",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Sampling start was observed.",      "properties": {        "details": {          "additionalProperties": false,          "type": "object"        },        "event": {          "const": "start_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Intent to stop sampling.",      "properties": {        "details": {          "additionalProperties": false,          "type": "object"        },        "event": {          "const": "stop_intent",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Sampling stop was observed.",      "properties": {        "details": {          "additionalProperties": false,          "type": "object"        },        "event": {          "const": "stop_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Intent to clean up PERF state.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "recovery": {              "anyOf": [                {                  "$ref": "#/$defs/SamplingCleanupRecovery"                },                {                  "type": "null"                }              ],              "description": "Present only as `true` when cleanup is part of recovery."            }          },          "type": "object"        },        "event": {          "const": "cleanup_intent",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "PERF cleanup was observed.",      "properties": {        "details": {          "additionalProperties": false,          "type": "object"        },        "event": {          "const": "cleanup_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "PERF cleanup failed with a bounded diagnostic.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "error": {              "description": "Failure diagnostic safe for durable logs.",              "maxLength": 1024,              "minLength": 1,              "type": "string"            },            "recovery": {              "anyOf": [                {                  "$ref": "#/$defs/SamplingCleanupRecovery"                },                {                  "type": "null"                }              ],              "description": "Present as `true` when this failure occurred during recovery."            }          },          "required": [            "error"          ],          "type": "object"        },        "event": {          "const": "cleanup_failed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Recovery state was observed before a new transaction proceeds.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "recovery": {              "$ref": "#/$defs/SamplingCleanupRecovery",              "description": "Recovery state was explicitly observed."            }          },          "required": [            "recovery"          ],          "type": "object"        },        "event": {          "const": "recovery_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Intent to export the final sampling artifact.",      "properties": {        "details": {          "additionalProperties": false,          "type": "object"        },        "event": {          "const": "export_intent",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    },    {      "description": "Exported artifact metadata was observed.",      "properties": {        "details": {          "additionalProperties": false,          "properties": {            "relative_path": {              "description": "Canonical path relative to the Session artifact directory.",              "maxLength": 1024,              "minLength": 1,              "pattern": "^(?=[\\u0020-\\u007E]+$)(?!/)(?!.*[<>:\"\\\\|?*])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*/$)(?!.*[. ](?:/|$))(?!(?:.*?/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9]) *(?:\\.[^/]*)?(?:/|$)).+$",              "type": "string"            },            "sha256": {              "description": "SHA-256 of the exported artifact bytes.",              "pattern": "^[0-9a-f]{64}$",              "type": "string"            },            "size_bytes": {              "description": "Nonzero byte size of the exported artifact.",              "format": "uint64",              "minimum": 1,              "type": "integer"            }          },          "required": [            "relative_path",            "sha256",            "size_bytes"          ],          "type": "object"        },        "event": {          "const": "export_observed",          "type": "string"        }      },      "required": [        "event",        "details"      ],      "type": "object"    }  ],  "properties": {    "endpoint_fingerprint": {      "description": "SHA-256 fingerprint for the exclusively leased TRACE32 endpoint.",      "pattern": "^[0-9a-f]{64}$",      "type": "string"    },    "observed_at": {      "description": "Bounded timestamp string observed by the sidecar.",      "maxLength": 64,      "minLength": 1,      "type": "string"    },    "owner": {      "$ref": "#/$defs/SamplingDriverOwner",      "description": "Fixed versioned sidecar identity that emitted this event."    },    "schema": {      "const": "t32perf.sampling-driver-event/v1",      "description": "The sampling-driver event schema version.",      "type": "string"    },    "sequence": {      "description": "Strictly positive append-only transaction sequence.",      "format": "uint64",      "minimum": 1,      "type": "integer"    },    "transaction_id": {      "description": "Canonical lowercase UUID v4 for the sampling transaction.",      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",      "type": "string"    }  },  "required": [    "schema",    "transaction_id",    "endpoint_fingerprint",    "owner",    "sequence",    "observed_at"  ],  "title": "SamplingDriverEvent",  "type": "object",  "unevaluatedProperties": false}