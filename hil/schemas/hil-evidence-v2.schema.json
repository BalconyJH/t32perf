{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t32perf.dev/schemas/hil/hil-evidence-v2.schema.json",
  "title": "T32Perf complete HIL evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "coverage", "captures", "verifications"],
  "properties": {
    "schema": {"const": "t32perf.hil-evidence/v2"},
    "source": {"const": "host-verified-session-artifacts"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boards",
        "mcu_families",
        "modes",
        "rtoses",
        "probes",
        "architecture_packages",
        "combinations",
        "verification"
      ],
      "properties": {
        "boards": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "mcu_families": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 2,
          "uniqueItems": true
        },
        "rtoses": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "probes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "architecture_packages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "combinations": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["board_id", "mode", "capture_count"],
            "properties": {
              "board_id": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "minLength": 1},
              "capture_count": {"type": "integer", "minimum": 10}
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_kinds",
            "required_fault_scenarios",
            "boards",
            "receipt_count"
          ],
          "properties": {
            "required_kinds": {
              "const": ["native_timeline", "resources", "fault_injection"]
            },
            "required_fault_scenarios": {
              "const": [
                "trace_overflow",
                "flow_error",
                "sampling_buffer_full",
                "elf_mismatch",
                "trace32_disconnect_recovery",
                "driver_disconnect_recovery",
                "cmm_abort_recovery"
              ]
            },
            "boards": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 2,
              "uniqueItems": true
            },
            "receipt_count": {"type": "integer", "minimum": 16}
          }
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 40,
      "items": {"$ref": "#/$defs/capture"}
    },
    "verifications": {
      "type": "array",
      "minItems": 16,
      "items": {"$ref": "#/$defs/verification"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "mcu_family",
        "rtos",
        "mode",
        "initial_state",
        "session_id",
        "trace32",
        "trace_routing",
        "manifest_sha256",
        "health_sha256"
      ],
      "properties": {
        "board_id": {"type": "string", "minLength": 1},
        "mcu_family": {"type": "string", "minLength": 1},
        "rtos": {"type": ["string", "null"], "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "initial_state": {"enum": ["running", "halted"]},
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "trace32": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "build",
            "probe_id",
            "architecture_package",
            "license_features",
            "capability_evidence_sha256"
          ],
          "properties": {
            "release": {"type": "string", "minLength": 1},
            "build": {"type": "integer", "minimum": 1},
            "probe_id": {"type": "string", "minLength": 1},
            "architecture_package": {"type": "string", "minLength": 1},
            "license_features": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "capability_evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "trace_routing": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "health_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "session_id",
        "kind",
        "scenario",
        "canonical_receipt_sha256",
        "receipt"
      ],
      "properties": {
        "board_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {"enum": ["native_timeline", "resources", "fault_injection"]},
        "scenario": {
          "enum": [
            null,
            "trace_overflow",
            "flow_error",
            "sampling_buffer_full",
            "elf_mismatch",
            "trace32_disconnect_recovery",
            "driver_disconnect_recovery",
            "cmm_abort_recovery"
          ]
        },
        "canonical_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "receipt": {
          "$ref": "https://t32perf.dev/schemas/hil/hil-verification-receipt-v1.schema.json"
        }
      }
    }
  }
}
